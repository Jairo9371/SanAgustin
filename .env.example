# Copia este archivo como .env; NO subas .env a GitHub.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-cadena-aleatoria-segura
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# En SSMS: haz clic en el servidor y usa su nombre EXACTO.
# Ejemplos: localhost ; .\\SQLEXPRESS ; NOMBRE-PC\\SQLEXPRESS
SQL_HOST=localhost
SQL_PORT=
SQL_DATABASE=SanAgustinDB
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Autenticación SQL Server: escribe usuario y contraseña.
# Autenticación Windows: deja ambos vacíos.
SQL_USER=
SQL_PASSWORD=

# Solo para desarrollo local si el certificado SQL Server es autofirmado.
# En producción debe ser false y usar certificado válido.
SQL_TRUST_CERT=true
